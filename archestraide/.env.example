# ArchestrAide environment variables
#
# All of these are OPTIONAL. With none set, the app runs fully on the
# deterministic, source-grounded answer composer (no external calls).

# Enable live LLM synthesis of the "short answer" via the Claude API.
# When set, /api/ask passes retrieved context to Claude under strict grounding
# instructions. Structure, sources and confidence still come from retrieval.
ANTHROPIC_API_KEY=

# Optional: override the model used for synthesis (default: claude-sonnet-4-6).
ARCHESTRAIDE_MODEL=claude-sonnet-4-6
